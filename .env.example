# Database (Neon)
DATABASE_URL=postgresql://...pooled connection string...
DATABASE_URL_DIRECT=postgresql://...direct connection string...

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry
# The API's DSN. Set per stage with `npx sst secret set SENTRY_DSN ...` — this
# entry is only for local scripts. The frontend's DSN is NOT here: it is public
# (it ships in the bundle) and lives as a literal in apps/web/sst.config.ts.
SENTRY_DSN=https://...@....ingest.sentry.io/...

# Only needed to upload frontend source maps from a local build; CI supplies
# its own. Without it `pnpm build` emits no source maps and skips the upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google OAuth (for Cognito federation)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Discord Envs (for account connection)
DISCORD_CLIENT_ID=...
DISCORD_CLIENT_SECRET=...
# Signs the OAuth `state` for account linking — deliberately separate from
# DISCORD_CLIENT_SECRET (see apps/api/src/utils/discordState.ts).
# Generate with: openssl rand -hex 32
DISCORD_STATE_SECRET=...

# GDDL (per user, stored encrypted — this is for local testing only)
GDDL_API_KEY=...