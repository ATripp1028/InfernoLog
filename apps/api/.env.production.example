# Read-only-by-convention production DB access for local admin tooling
# (Prisma Studio, one-off scripts). Copy to .env.production and fill in the
# real values — that file is gitignored (.env.*) and never committed.
#
# Get the values from the production SST secrets (`npx sst secret list --stage
# production` from apps/api) or the Neon dashboard.
#
# Usage: pnpm db:studio:prod

DATABASE_URL=
DATABASE_URL_DIRECT=
