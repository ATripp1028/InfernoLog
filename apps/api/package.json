{
  "name": "@infernolog/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "sst dev",
    "deploy:staging": "sst deploy --stage staging",
    "deploy:prod": "sst deploy --stage production",
    "remove:staging": "sst remove --stage staging",
    "build": "pnpm typecheck",
    "typecheck": "prisma generate && tsc --noEmit",
    "typecheck:infra": "tsc -p tsconfig.infra.json",
    "lint": "eslint --max-warnings 0 --ext .ts src infra sst.config.ts",
    "postinstall": "prisma generate",
    "export-sst-env": "bash export-sst-env.sh",
    "db:backfill:sfh": "tsx src/scripts/backfillSfhData.ts",
    "db:backfill:levels": "tsx src/scripts/backfillLevelMetadata.ts",
    "db:seed:official": "tsx src/scripts/seedOfficialLevels.ts",
    "db:studio:prod": "dotenv -e .env.production -- prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1032.0",
    "@aws-sdk/client-kms": "^3.1072.0",
    "@aws-sdk/client-lambda": "^3.1072.0",
    "@aws-sdk/client-sqs": "^3.1076.0",
    "@hono/node-server": "^2.0.10",
    "@infernolog/core": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "5.22.0",
    "@sentry/aws-serverless": "^10.49.0",
    "@sentry/node": "^10.49.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.34",
    "pino": "^10.3.1",
    "sentry": "^0.28.1",
    "vitest-mock-extended": "^4.0.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@infernolog/tsconfig": "workspace:*",
    "@prisma/adapter-pg": "5.22.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.1",
    "pg": "^8.22.0",
    "prisma": "5.22.0",
    "sst": "4.7.9",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.83.0"
  },
  "packageManager": "pnpm@8.15.5"
}
