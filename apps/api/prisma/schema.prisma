// InfernoLog — Prisma Schema
// Database: PostgreSQL (Neon)
//
// Core principles:
//  - Level identity is the in-game GD level ID (Level.inGameId), not a UUID.
//    Reuploads share the same in-game data and are treated as the same level.
//  - Level metadata is a shared cache (Level), reused across every user who
//    logs the same level rather than duplicated per user.
//  - List-tier/rank values are snapshotted at time of logging and never
//    silently updated later.
//  - Progress over completions: the fundamental unit is ProgressUpdate. A
//    completion is just a ProgressUpdate with kind = COMPLETION; a drop is
//    kind = DROP. There's no separate table for "attempting" vs "completed"
//    vs "dropped" — see the ProgressUpdate model below.
//  - Rating scores are always stored raw per-category; weighted averages are
//    computed at query time, never stored.
//  - Classic and platformer levels are parallel, independent systems
//    (LevelType), accommodated from day one.
//
// Relationship shape (one row per user per level, except Level itself, which
// is a shared cache):
//
//   User ──┬── LevelProgress ──┬── ProgressUpdate
//          │                   ├── ClassicDemonList
//          │                   └── RatingScore ── RatingCategory
//          └── Collection ── CollectionEntry
//
//   LevelProgress.levelId and CollectionEntry.levelId both FK to
//   Level.inGameId. Adding a level to a Collection (e.g. Want to Beat) does
//   NOT create a LevelProgress row — that only happens on the user's first
//   logged progress update.

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
  previewFeatures = ["driverAdapters", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_DIRECT")
  // pg_trgm powers the fuzzy/typo-tolerant level name search
  // (Level.name GIN index below). See routes/levels.ts.
  extensions = [pgTrgm(map: "pg_trgm")]
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  USER
  MODERATOR
  ADMIN
}

// SUSPENDED/BANNED are placeholders in v1: no code currently reads or sets
// accountStatus, and there is no moderation route implementation (see
// docs/MODERATION.md for the intended design — a ban should permanently
// delete the user's content and hold their username so it can't be
// reclaimed, but neither is built). The one deletion path that IS
// implemented is user-initiated: DELETE /v1/me (apps/api/src/routes/me.ts)
// hard-deletes the User row, which cascades to LevelProgress/ProgressUpdate/
// Collection/etc. via the onDelete: Cascade relations below.
enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// SIMPLE = one score per level (LevelProgress.simpleRating).
// WEIGHTED = per-category scores (RatingScore rows) that are combined into a
// weighted average.
// MANUAL = the user orders their completions by hand and the POSITION is the
// rating — there is no number. computeOverallRating returns null in this mode,
// and the Ranking page reads rating_ranking.ratingIndex instead. See RATING_SYSTEM.md.
// Works identically to the demon list
enum RatingMode {
  SIMPLE
  WEIGHTED
  MANUAL
}

enum DateFormatPreference {
  MDY // MM/DD/YYYY — US
  DMY // DD/MM/YYYY — International
  YMD // YYYY/MM/DD — ISO with slashes
  ISO // YYYY-MM-DD — ISO with dashes
}

enum LevelType {
  CLASSIC
  PLATFORMER
}

// State machine for LevelProgress.status:
//
//   want_to_beat (Collection only — no LevelProgress row yet)
//        │ user logs first progress/drop/completion update
//        ▼
//   IN_PROGRESS ──drop───────► DROPPED
//        ▲                        │
//        └────new progress log────┘  (automatic — logging progress implies
//                                      active play, no explicit "resume")
//        │
//        └──log 100% / completion──► COMPLETED
//
// - A LevelProgress row is created on the user's first action for that
//   level. That action can be a progress log (-> IN_PROGRESS), a completion
//   (-> COMPLETED), or a drop (-> DROPPED directly, "drop-from-scratch" — the
//   row need not pass through IN_PROGRESS first). Every one of these actions
//   creates a ProgressUpdate row; no action creates a LevelProgress without
//   one.
// - A level can be dropped more than once (drop -> resume -> drop again) —
//   each drop is its own ProgressUpdate (kind = DROP), so full history
//   survives even though `status` only reflects the current state.
// - COMPLETED is left untouched by further progress logs in v1 (rebeat is a
//   future feature).
// - See docs/LOGGING_FLOW_RECONCILIATION.md for the dropped -> in_progress
//   auto-flip and drop-from-scratch decisions.
enum LevelProgressStatus {
  IN_PROGRESS
  DROPPED
  COMPLETED
}

// What a ProgressUpdate row represents. Order matters: PROGRESS and DROP are
// declared before COMPLETION so `orderBy: { kind: 'desc' }` (Postgres native
// enums sort by declaration order) puts a completion first regardless of
// loggedAt — the "representative update" query's replacement for the old
// `isCompletion desc` sort.
enum ProgressUpdateKind {
  PROGRESS
  DROP
  COMPLETION
}

// Per-entry privacy override, independent of User.profilePublic — e.g. hide
// a completion until a YouTube video goes live while keeping the rest of the
// profile public. A private profile forces everything private regardless of
// this setting; a public profile respects it per-entry.
//
// Currently only exposed on LevelProgress.visibility (below). Extending this
// to ProgressUpdate and CollectionEntry, so an individual logged event or
// collection entry can be hidden independently, is designed but not built —
// there's no public-profile route consuming it yet either; every route in
// apps/api/src/routes is currently scoped to the authenticated user's own
// /me/* endpoints.
enum EntryVisibility {
  PUBLIC
  PRIVATE
}

// What an ActivityLog row records. See docs/EVENT_LOG.md for the taxonomy and
// apps/api/src/services/activityLog for the emission API.
//
// Two event types rewrite the whole fractional-index space at once, and they
// are separate BECAUSE one is visible to the user and the other is not:
//
//   DEMON_LIST_BULK_REPLACE — the spreadsheet import replaced the user's ranking.
//     The order the user sees really did change, so this is a normal
//     user-facing event. It is ONE event for the whole replace, not one per
//     level: the user performed a single import, and a feed that spelled it out
//     level by level would bury every other event they have. The levels it
//     touched are its impact rows.
//
//   DEMON_LIST_REBALANCE, RATING_REBALANCE — INTERNAL ONLY. The renormalisation inside
//     services/ranking, which rewrites every index while leaving the ORDER
//     untouched. It exists so every level's logged listIndex history stays
//     in one coordinate system and reconstruction can't silently drift. The
//     user saw nothing and did nothing, so it must be filtered out of any
//     Log/timeline surface and out of any future Discord event-type → channel
//     mapping. It is the only hidden type in this enum.
enum ActivityEventType {
  DEMON_LIST_PLACEMENT
  DEMON_LIST_REORDER
  DEMON_LIST_REMOVED
  DEMON_LIST_BULK_REPLACE
  DEMON_LIST_REBALANCE
  RATING_PLACEMENT
  RATING_REORDER
  RATING_REMOVED
  RATING_BULK_REPLACE
  RATING_REBALANCE
  LOG_EDIT
  RATING_CONFIG_CHANGE
}

// Why a level appears on a demon list event. MOVER is the level the user acted
// on (and, on a DEMON_LIST_REBALANCE, every level whose index was rewritten —
// nothing "moved" there, but nothing is a bystander either). NEIGHBOR is a
// level immediately adjacent to the mover before or after the move, carried so
// the event records the local context it changed. Levels further down the list
// whose ordinal merely shifted are deliberately NOT recorded — see
// docs/DEMON_LIST.md, "direct events only".
enum ActivityImpactRole {
  MOVER
  NEIGHBOR
}

// The filter key for ActivityLogFieldChange rows. Filtering keys off THIS, not
// off fieldName, so a new editable field only has to be given a category
// instead of being added to a hardcoded field list everywhere that filters.
//
//   RATING         — the level's rating: simple rating, per-category weighted
//                    scores, per-event enjoyment.
//   SESSION_DETAIL — the run/session: percentage, run range, attempts, date,
//                    fps, device, notes, and the rest of the Session Details
//                    step (see docs/LOGGING_FLOW.md).
//   METADATA       — the user's read of the LEVEL rather than of one run:
//                    difficulty opinion, GDDL tier opinion, level notes.
//   RATING_CONFIG  — weighted-mode configuration, on RATING_CONFIG_CHANGE
//                    events only. Never appears on a LOG_EDIT.
enum ActivityFieldCategory {
  RATING
  SESSION_DETAIL
  METADATA
  RATING_CONFIG
}

enum CollectionType {
  WANT_TO_BEAT
  FAVORITES
  LEAST_FAVORITES
  CUSTOM
}

enum ReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}

enum AppealStatus {
  PENDING
  APPROVED
  DENIED
}

enum ModerationActionType {
  WARN
  SUSPEND
  BAN
  UNBAN
  VERIFY
  UNVERIFY
}

enum RatingDisplayScale {
  ZERO_TO_TEN     // Displayed as 0.0-10.0 with one decimal e.g. 7.5
  ZERO_TO_HUNDRED // Displayed as 0-100 integer e.g. 75
  // Stored internally as 0-100 integer regardless of display preference.
  // Conversion: ZERO_TO_TEN display = internal / 10
  //             ZERO_TO_HUNDRED display = internal (no conversion)
}

// The user's subjective difficulty read on a completion — the ONLY difficulty
// field the user edits. Distinct from the level's cached in-game difficulty
// (Level.inGameDifficulty). The non-demon star values (AUTO..NINE_STAR) are a
// disagreement flag only; the level stays a rated demon. See LOGGING_FLOW.md.
enum DifficultyOpinion {
  AUTO
  TWO_STAR
  THREE_STAR
  FOUR_STAR
  FIVE_STAR
  SIX_STAR
  SEVEN_STAR
  EIGHT_STAR
  NINE_STAR
  EASY
  MEDIUM
  HARD
  INSANE
  EXTREME
}

enum Device {
  pc
  mobile
}

// GD 2.1 measured percentage by distance to the endwall (speed-dependent).
// GD 2.2 reworked to time-based: 100% = duration of the verification attempt.
enum GdVersion {
  TWO_ONE
  TWO_TWO
}

// ─────────────────────────────────────────────
// ROBTOP RATE LIMIT
// ─────────────────────────────────────────────

// Single shared token bucket, checked by every path that calls
// fetchRobtopLevel (levelSeedWorker, the volatile/standard sync crons, the
// GET /levels/:id/resolve endpoint, gddlListSync, gddlSync) so their combined
// request rate — not just each path's own independent pacing — stays under
// RobTop's tolerance. A DB row rather than in-memory state because Lambda
// invocations don't share memory; see apps/api/src/utils/robtopRateLimit.ts.
// Always exactly one row (id = "singleton").
model RobtopRateLimit {
  id           String   @id @default("singleton")
  tokens       Float
  lastRefillAt DateTime @default(now())
  // Set when a caller reports a RobTop 429 (see utils/robtopRateLimit.ts). While
  // now() < cooldownUntil no token is granted, so EVERY RobTop consumer (sync,
  // resolve, GDDL syncs) backs off together and lets the per-IP block recover
  // instead of prolonging it. Null when not throttled.
  cooldownUntil DateTime?

  @@map("robtop_rate_limit")
}

// Per-user budget for RobTop calls made on a user's behalf, sitting IN FRONT OF
// the shared singleton bucket above. The two solve different problems and both
// are needed: RobtopRateLimit protects RobTop from InfernoLog in aggregate, but
// it is a global with no notion of who spent it — one account looping a
// RobTop-reaching endpoint can drain it and degrade level resolution for
// everyone. This attributes the spend.
//
// Charged only when a request is actually about to call RobTop, never on a
// cache hit (see utils/robtopUserBudget.ts), so ordinary use never touches it:
// resolving a level already in the cache is free, and a level resolved once is
// cached from then on. What it bounds is the traffic that CANNOT be absorbed by
// the cache — repeated lookups of ids GD has no level for (a not-found is
// deliberately never cached, so every retry is a fresh RobTop call) and the
// gd-search escalation, which calls out unconditionally.
//
// Same token-bucket shape as RobtopRateLimit, one row per user, created lazily
// on first charge. Cascades with the user.
model RobtopUserBudget {
  userId       String   @id
  tokens       Float
  lastRefillAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("robtop_user_budget")
}

// Round-robin cursor for the RobTop level-cache sync. The sync no longer runs
// as one big monthly batch (which mass-tripped RobTop's rate limit); instead a
// frequent cron processes a bounded slice of levels ordered by inGameId,
// advancing this cursor each run and wrapping to the start at the end. Always
// exactly one row (id = "singleton"); a missing/null cursor means "start over".
// lastInGameId is a lexicographic marker (ids are compared as strings, matching
// the sync's orderBy) — it's just a stable rotation position, not a numeric max.
// See apps/api/src/services/levelSync.ts.
model LevelSyncCursor {
  id           String   @id @default("singleton")
  lastInGameId String?
  updatedAt    DateTime @updatedAt

  @@map("level_sync_cursor")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id                    String               @id @default(uuid())
  username              String               @unique
  usernameChangedAt     DateTime?
  previousUsername      String?
  email                 String               @unique
  discordId             String?              @unique
  cognitoSub            String?              @unique
  onboardingCompleted   Boolean              @default(false)
  // Set when the user checks "I agree" on the combined ToS/Privacy Policy
  // view during onboarding. Null means never accepted (pre-onboarding-rebuild
  // accounts, or an in-progress signup).
  legalAcceptedAt       DateTime?

  // Privacy — global override. A private profile forces all entries private
  // regardless of per-entry EntryVisibility; see that enum for the current
  // (partial) state of per-entry privacy.
  profilePublic         Boolean              @default(true)
  discordPublic         Boolean              @default(true)

  // Role & status
  role                  Role                 @default(USER)
  accountStatus         AccountStatus        @default(ACTIVE)
  suspensionUntil       DateTime?

  // Verification — derived as verifiedAt != null (see PublicUserProfileSchema).
  verifiedAt            DateTime?

  // GDDL integration — key stored encrypted, never exposed to frontend.
  // gddlUsername is the GDDL account name confirmed when the key is verified;
  // it is public and shown in the connected-accounts UI.
  gddlApiKeyEncrypted   String?
  gddlUsername          String?              @unique

  // Preferences
  ratingMode            RatingMode           @default(SIMPLE)
  // Default FPS pre-filled into the Log Level form. Always >= 60 (the GD
  // floor); enforced at the application layer.
  defaultFps            Int                  @default(60)
  // Default GD version for percentage interpretation (2.1 = distance-based,
  // 2.2 = time-based). Pre-filled into the Log Level form.
  defaultPercentageVersion GdVersion         @default(TWO_TWO)
  // Default device pre-filled into the Log Level form.
  defaultDevice         Device               @default(pc)
  timeMachineTopN       Int                  @default(10)
  dateFormatPreference  DateFormatPreference @default(MDY)
  ratingDisplayScale    RatingDisplayScale   @default(ZERO_TO_TEN)
  showHighlightUrl      Boolean              @default(false)
  // Desktop FABs (logging, level-page, collections): whether hovering the
  // group immediately shows every action's label, vs. only the one under
  // the pointer. Defaults on so new users can learn the icons.
  autoExpandFabLabels   Boolean              @default(true)
  includeEnjoyment      Boolean              @default(false)
  // Weights are normalized: sum of active rating-category weights plus
  // enjoymentWeight (when includeEnjoyment is true) must equal 1.00 (in
  // integer cents). Two decimal places — UI distributes any 1/N remainder
  // to the top item in the priority order rather than chasing precision.
  enjoymentWeight       Decimal              @default(0) @db.Decimal(5, 2)
  // Position of the "enjoyment" virtual row in the unified priority list.
  // 99 puts it after any reasonable number of categories the first time
  // a user enables enjoyment; explicit drags overwrite.
  enjoymentSortOrder    Int                  @default(99)

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  // Relations
  levelProgress         LevelProgress[]
  classicDemonList      ClassicDemonList[]
  ratingRanking         RatingRanking[]
  collections           Collection[]
  apiKeys               ApiKey[]
  ratingCategories      RatingCategory[]
  logPresets            LogPreset[]
  importJob             ImportJob?
  robtopBudget          RobtopUserBudget?
  reportsSubmitted      Report[]             @relation("ReporterRelation")
  reportsReceived       Report[]             @relation("ReportedUserRelation")
  reportsModerated      Report[]             @relation("AssignedModeratorRelation")
  banAppeals            BanAppeal[]
  moderationActionsBy   ModerationAction[]   @relation("ModeratorRelation")
  moderationActionsOn   ModerationAction[]   @relation("TargetUserRelation")
  banAppealsReviewed    BanAppeal[]          @relation("ReviewedByRelation")
  activityLog           ActivityLog[]

  @@map("users")
}

// ─────────────────────────────────────────────
// LEVELS (shared cache, keyed by in-game ID)
// ─────────────────────────────────────────────

model Level {
  // Primary key is the in-game GD level ID, not a UUID.
  // Every GD API uses this as source of truth.
  // Reuploads share the same in-game data and are treated as the same level.
  inGameId              String               @id
  levelType             LevelType            @default(CLASSIC)
  isRated               Boolean              @default(false)
  // Whether GD classifies this as a demon. Cached from GDBrowser's `demon`
  // flag. Drives the informational non-demon notice in the logging flow and
  // demon-first display ordering; it gates no capability — a non-demon can be
  // logged, rated and ranked exactly like a demon.
  isDemon               Boolean              @default(false)

  // Core metadata — populated by GDBrowser autofill
  name                  String?
  creator               String?
  // The level's actual rated difficulty (e.g. "Insane Demon"), cached from
  // GDBrowser and read-only in the UI — EXCEPT on the manual-entry fallback,
  // where the user-entered difficulty becomes this value (data_source=manual).
  //
  // For a NON-DEMON this is the display copy, not the identifier: `stars` is
  // canonical and wins wherever the two disagree — see deriveInGameDifficulty
  // in packages/core, which every read path goes through. The face is a BAND
  // over the star range (Hard is 4-5, Harder 6-7, Insane 8-9), so the count
  // determines the label but the label does NOT determine the count — which is
  // exactly why the count is the canonical one. Both are written together from
  // the same RobTop snapshot, so they only diverge if something writes one
  // alone.
  //
  // For DEMONS and UNRATED levels this column is the only representation there
  // is: all five demon tiers share 10 stars, and "Unrated" has no stars at all.
  //
  // The per-user difficulty *opinion* lives on ProgressUpdate.difficultyOpinion,
  // and is on a DIFFERENT, subjective 1-9 star scale. Don't mix the two.
  inGameDifficulty      String?
  // Human-readable level length (e.g. "Long", "XL"), cached from GDBrowser or
  // entered on the manual-entry fallback.
  length                String?
  songName              String?              // Newgrounds song
  songAuthor            String?

  // NONG fields (v2) — sourced entirely from Song File Hub, never manually
  // entered. isNong is derived from SFH: true when a match is found (rated
  // levels query the rated catalog, unrated levels the unrated one), false when
  // SFH confirms none. sfhCheckedAt is null until a call to SFH SUCCEEDS (found
  // and not-found are both a "success" — only network/timeout failures leave it
  // null). A level is re-checked at most once every ~6 months (SFH_RECHECK_DAYS)
  // since a level's song almost never changes; a null sfhCheckedAt is always due
  // so failed checks retry. See EXTERNAL_APIS.md decision log.
  isNong                Boolean              @default(false)
  sfhCheckedAt          DateTime?
  sfhId                 String?              // SFH's _id — canonical key if
                                             // multiple results ever appear
  // NOTE: SFH's `songID` is deliberately NOT stored. An SFH entry is keyed by
  // the Newgrounds song it replaces, so it always equals this level's `songId`
  // (the in-game placeholder song) — a separate column only invited a false
  // "all levels using this song" query. Read `songId` for the song identity.
  sfhSongName           String?              // raw "Artist - Title" as
                                             // returned by SFH, unsplit
  sfhYoutubeUrl         String?              // songURL
  sfhYoutubeVideoId     String?              // ytVideoID
  sfhDownloadUrl        String?              // downloadUrl
  sfhFileType           String?              // filetype
  sfhDownloads          Int?                 // used to pick canonical if
                                             // multiple results ever appear

  // ── Extended GDBrowser metadata ──────────────────────────────────────────
  // A snapshot of everything RobTop's level object exposes (via GDBrowser), so
  // we retain the data even if the level later changes or is deleted upstream,
  // and can surface more of it in the UI later without a re-fetch. All optional:
  // null on manual rows and on rows cached before this was added. See
  // EXTERNAL_APIS.md and https://wyliemaster.github.io/gddocs (level object).
  description           String?
  // Creator identity beyond the display name.
  creatorPlayerId       String?
  creatorAccountId      String?
  // Rating / difficulty detail. stars is the awarded star/moon count (0 when
  // unrated → isRated) and, for a non-demon, the CANONICAL identifier of its
  // difficulty: 1-9, banded onto the six faces (see starDifficulty.ts), with
  // inGameDifficulty above as the display copy. Demons are always 10 regardless
  // of tier. partialDiff is GDBrowser's machine-readable difficulty token
  // ("demon-extreme", "demon-extreme-featured").
  stars                 Int?
  starsRequested        Int?
  partialDiff           String?
  // Engagement / stats.
  downloads             Int?
  likes                 Int?
  disliked              Boolean?
  objectCount           Int?
  coins                 Int?
  coinsVerified         Boolean?
  // Showcase flags. epicValue: 0 none, 1 epic, 2 legendary, 3 mythic.
  featured              Boolean?
  featureScore          Int?
  epicValue             Int?
  // Build / publish detail.
  twoPlayer             Boolean?
  lowDetailMode         Boolean?
  copiedFromId          String?
  levelVersion          Int?
  gameVersion           String?
  // Song detail beyond name/author. officialSongId is set when the level uses a
  // built-in track; songId is the Newgrounds/custom song id otherwise.
  officialSongId        Int?
  songId                String?
  songLink              String?
  // Raw megabyte value (e.g. 9.56). Format at the display layer.
  songSize              Float?

  // Data provenance
  dataSource            String               @default("manual") // "robtop_autofill" | "manual" | "official"
  // False for `manual` rows until a later RobTop sync backfills/verifies
  // (and may override) the manually-entered metadata.
  verified              Boolean              @default(false)

  // RobTop sync job fields
  // See EXTERNAL_APIS.md — a single frequent cron round-robins the cache a
  // bounded slice at a time (services/levelSync.ts), overwriting on diff. No
  // staging, no nudges.
  lastCheckedAt         DateTime?
  // Stamped whenever `isRated` flips or `inGameDifficulty` changes value.
  ratingStatusSince     DateTime?
  // Set the FIRST time a sync sees the level missing from GD (RobTop "not
  // found"), and cleared the moment it's seen again. Delisting is NOT immediate:
  // a level must stay missing past a confirmation window (see levelSync.ts) so a
  // transient RobTop "-1"/rate-limit blip can't delist a live level. Null while
  // the level is present.
  missingSince          DateTime?
  // Set once a level has been confirmed gone (missing past the window) — derived
  // as delistedAt != null. A delisted row is frozen at its last-known values and
  // excluded from the main sync, but a low-cadence reverify pass re-checks it and
  // clears this if the level reappears (reuploads reuse the same inGameId).
  delistedAt            DateTime?

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  // Relations
  levelProgress         LevelProgress[]
  collectionEntries     CollectionEntry[]
  activityLog           ActivityLog[]
  activityImpacts       ActivityLogLevelImpact[]

  // pg_trgm GIN index powering fuzzy/typo-tolerant name search
  // (GET /v1/levels/search). Queried via the `%` operator / similarity().
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  // Difficulty is the most common (and most selective) /v1/levels/browse
  // filter. This lets the browse bitmap-scan the matching difficulty subset and
  // sort just that, instead of seq-scanning + sorting the whole levels cache.
  @@index([partialDiff])
  // NOTE: two more browse indexes exist that Prisma can't represent here —
  // expression indexes on ((COALESCE("downloads", -1))::float8, "inGameId") and
  // the same for "likes", added in migration 20260804000100. They serve the
  // "most downloaded / liked" full-cache browse sorts (see services/levelBrowse
  // sortDef). They're managed by hand in that migration; if a generated migration
  // ever tries to DROP levels_browse_downloads_idx / levels_browse_likes_idx,
  // that drop is spurious — keep the indexes.
  @@map("levels")
}

// ─────────────────────────────────────────────
// LEVEL PROGRESS
// One row per user per level.
// Created when the user logs their FIRST progress update.
// NOT created by adding a level to the want-to-beat list.
// ─────────────────────────────────────────────

model LevelProgress {
  id              String               @id @default(uuid())
  userId          String
  levelId         String               // FK → levels.inGameId

  status          LevelProgressStatus  @default(IN_PROGRESS)

  // Best run from 0% (percentage) reached before beating or dropping the level
  // — the user's "worst fail". Captured on the completion and drop screens.
  // Level-scoped (one value per user/level), updated on each such log.
  worstFail       Int?
  // Date/time of the worst fail session. Time-of-day is optional — null
  // worstFailDateTimezone means no time was entered (legacy rows and the
  // common case), in which case this is midnight UTC and no time/zone is
  // ever shown. Null worstFailDate means the user opted out ("I already
  // logged my worst fail") or left it blank.
  worstFailDate         DateTime?
  // IANA zone the time-of-day above was entered in (e.g. "America/New_York").
  // Null whenever worstFailDate has no time component.
  worstFailDateTimezone String?

  // Per-entry privacy — independent of global profile visibility.
  // Use case: hide a completion until YouTube video goes live.
  visibility      EntryVisibility      @default(PUBLIC)

  // "About this level overall" — distinct from progress_updates.notes (which is
  // per-completion). Survives edits or deletions of individual progress updates.
  // One value per user per level.
  levelNotes      String?

  // The user's own opinion on the level's GDDL tier. Set during completion
  // logging or via the edit form. Null when the user has not given an opinion.
  userGddlTier    Int?
  // The user's subjective difficulty opinion (the only difficulty they edit).
  // Non-demon opinions carry their own star count (AUTO..NINE_STAR) rather
  // than a separate paired field. See LOGGING_FLOW.md.
  //
  // Level-scoped, not per-event: this is the user's read of the LEVEL, not of
  // one run — the same classification the activity log has always given it
  // (ActivityFieldCategory.METADATA, alongside userGddlTier and levelNotes,
  // both of which already live here). It lived on ProgressUpdate until
  // 2026-09-02; see that migration for the backfill.
  difficultyOpinion DifficultyOpinion?

  // The user's single rating for this level (SIMPLE mode) — one score per
  // level, not one per logged event. WEIGHTED mode scores live in
  // RatingScore, also keyed on this row. Editable from any progress-editing
  // surface, not just the completion. 0-100 internally.
  simpleRating    Int?
  // Coins collected bitmask (bit 0 = coin 1, etc.) — only meaningful once the
  // level is completed (coins only count on the winning attempt). Null = not
  // logged.
  coinsCollected  Int?
  // Platformer levels only (v2): time of the completing attempt, in seconds.
  completionTime  Int?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Relations
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  level           Level                @relation(fields: [levelId], references: [inGameId])
  progressUpdates ProgressUpdate[]
  classicDemonList ClassicDemonList?
  ratingRanking    RatingRanking?
  ratingScores    RatingScore[]

  @@unique([userId, levelId]) // One LevelProgress per user per level
  @@map("level_progress")
}

// ─────────────────────────────────────────────
// PROGRESS UPDATES
// Every logged event for a level: a session log, a completion, or a drop.
// A completion is a ProgressUpdate with kind = COMPLETION; a drop is one with
// kind = DROP, reusing date/attempts/notes rather than drop-specific fields —
// a drop's reason is just its `notes` under a different label, its date is
// just its `date`, and so on. Same reasoning as percentage/runFrom/runTo
// being shared between progress and completion rows: the columns describe
// an event, and `kind` says which kind of event it is. All fields optional
// except levelProgressId, kind, and loggedAt. Non-completion entries hidden
// throughout the UI unless the "show non-completions" toggle is active.
// ─────────────────────────────────────────────

model ProgressUpdate {
  id                    String          @id @default(uuid())
  levelProgressId       String

  // What this row represents. Only one COMPLETION per LevelProgress may exist
  // (enforced at application level); DROP may repeat (drop → resume → drop
  // again each get their own row).
  kind                  ProgressUpdateKind @default(PROGRESS)

  // Progress data
  // percentage: classic levels only (0-100). Null for platformer.
  percentage            Decimal?        @db.Decimal(5, 2)
  // runFrom/runTo: best run range e.g. 44-87
  runFrom               Int?
  runTo                 Int?

  // Attempt tracking
  // Convention: cumulative attempts across ALL uploads/copies of the level.
  // Honor system — cannot be enforced technically. Documented in UI tooltip.
  attempts              Int?

  // Session metadata
  // Time-of-day is optional — null dateTimezone means no time was entered
  // (legacy rows and the common case), in which case this is midnight UTC
  // and no time/zone is ever shown.
  date                  DateTime?
  // IANA zone the time-of-day above was entered in (e.g. "America/New_York").
  // Null whenever date has no time component.
  dateTimezone          String?
  dateUncertain         Boolean         @default(false)
  onStream              Boolean         @default(false)
  fps                   Int?
  // Which GD version's percentage system was used. Only meaningful for classic
  // levels (percentage/runFrom/runTo). Null = not recorded (legacy entries).
  percentageVersion     GdVersion?

  // Ratings
  // enjoyment: logged per-event (any progress update, not just completions) —
  // mirrors the GDDL's approach. Distinct from simpleRating/ratingScores,
  // which live on LevelProgress (one current value per level, not per event).
  enjoyment             Int?            // 0-100 internally. Display conversion applied in UI per user.ratingDisplayScale

  // Contextual metadata
  // Snapshot of in-game difficulty rating at time of logging
  // e.g. "Insane Demon", "Easy Demon". Can differ from current rating.
  // Populated automatically from the Level cache — never user-edited.
  inGameDifficulty      String?
  notes                 String?

  // Media
  videoUrl              String?         // Completion video
  highlightUrl          String?         // Highlight reel — independent of onStream

  // 2-player level logging. Null = not a 2-player level or not logged.
  // true = beat it solo; false = beat it with a partner.
  twoPlayerSolo         Boolean?
  twoPlayerPartner      String?         // Partner name when twoPlayerSolo = false

  // Device the level was beaten on. Null = not logged.
  device                Device?

  loggedAt              DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  levelProgress         LevelProgress   @relation(fields: [levelProgressId], references: [id], onDelete: Cascade)

  @@map("progress_updates")
}

// ─────────────────────────────────────────────
// RATING CATEGORIES (Weighted Mode)
// User-configured categories for weighted average rating.
// Default categories: Gameplay, Decoration, Song
// ─────────────────────────────────────────────

model RatingCategory {
  id                String          @id @default(uuid())
  userId            String

  name              String
  // Normalized weight in [0, 1] to two decimal places; sum of active
  // weights for a user (plus enjoyment when enabled) must equal 1.00.
  // See User.enjoymentWeight.
  weight            Decimal         @db.Decimal(5, 2)
  sortOrder         Int

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // No onDelete action — RatingScore rows for a deleted category must be
  // removed explicitly by the caller (see PUT /v1/me/rating-config) before
  // deleting the category, or the categoryId FK on rating_scores rejects it.
  ratingScores      RatingScore[]

  // Each user's category names must be unique. Also makes the default-seed
  // path safe under concurrent transitions to WEIGHTED — duplicate inserts
  // fail with P2002, which `createMany({ skipDuplicates: true })` silently
  // drops instead of producing 6 categories.
  @@unique([userId, name])
  @@map("rating_categories")
}

// ─────────────────────────────────────────────
// RATING SCORES
// Per-category scores per level (one set per LevelProgress, not per event —
// see LevelProgress.simpleRating for the SIMPLE-mode counterpart).
// Weighted average computed at query time — never stored.
// ─────────────────────────────────────────────

model RatingScore {
  id                String          @id @default(uuid())
  levelProgressId   String
  categoryId        String

  score             Int             // 0-100 internally. Display conversion applied in UI per user.ratingDisplayScale

  // Relations
  levelProgress     LevelProgress   @relation(fields: [levelProgressId], references: [id], onDelete: Cascade)
  ratingCategory    RatingCategory  @relation(fields: [categoryId], references: [id])

  @@unique([levelProgressId, categoryId])
  @@map("rating_scores")
}

// ─────────────────────────────────────────────
// CLASSIC RANKING
// Personal difficulty ranking of classic completions.
// Fractional indexing — positions stored as Decimal to allow
// insertion between existing entries without renumbering.
//
// Example:
//   1.0 ── 2.0 ── 3.0  (initial)
//   Insert between 2 and 3 → 2.5
//   Insert between 2 and 2.5 → 2.25
//   Gap < 0.0001 → renormalize the whole list to integers, then insert
//
// The renormalization is NOT a background job (earlier comments here called it
// "the rebalancing job"; no such cron exists). It runs inline, inside the
// transaction of the placement or reorder that found the gap too tight — see
// rebalance() in services/ranking. The spreadsheet import's full replace
// rewrites the same index space the same way.
//
// EVERY write that touches listIndex must emit an ActivityLog event
// (see services/activityLog and docs/EVENT_LOG.md). An index written without
// one is a permanent hole in that level's history — the old value is gone.
//
// Only LevelProgress entries with status = COMPLETED appear here.
// ─────────────────────────────────────────────

model ClassicDemonList {
  id                String          @id @default(uuid())
  userId            String
  levelProgressId   String          @unique // One demon list entry per level

  // Fractional index — lower = easier, higher = harder
  listIndex         Decimal         @db.Decimal(20, 10)

  // Relations
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelProgress     LevelProgress   @relation(fields: [levelProgressId], references: [id], onDelete: Cascade)

  @@map("classic_demon_list")
}

// ─────────────────────────────────────────────
// COLLECTIONS
// Favorites, least favorites, want-to-beat, and custom collections.
// Adding to want-to-beat does NOT create a LevelProgress entry.
// Entry order uses fractional indexing (same pattern as ClassicDemonList):
// insert between two entries by averaging their indices; a renormalization
// pass resets to integers when a gap shrinks past 0.0001.
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// RATING RANKING
// The MANUAL rating mode's ordering: the user's completions arranged by hand,
// best first, where the POSITION is the rating and no number exists.
//
// Deliberately the same shape as ClassicDemonList, because it is the same
// problem on a different axis — quality rather than difficulty. Fractional
// index, bisect to insert, inline renormalisation when a gap closes past
// 0.0001 (utils/fractionalIndex).
//
// EVERY write that touches ratingIndex must emit an ActivityLog event (the
// RATING_* types), rebalances included. An index written without one is a
// permanent hole in that level's history — the old value is simply gone.
// services/invariants.integration.test.ts sweeps for it.
//
// Rows exist only while the user is in MANUAL mode; switching away leaves them
// in place, so switching back restores the order rather than losing it — the
// same "mode switching preserves all data" rule simple/weighted already follow.
// ─────────────────────────────────────────────

model RatingRanking {
  id                String          @id @default(uuid())
  userId            String
  levelProgressId   String          @unique // One rating position per level

  // Fractional index — higher = better rated, so display order is DESC.
  ratingIndex       Decimal         @db.Decimal(20, 10)

  // Relations
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelProgress     LevelProgress   @relation(fields: [levelProgressId], references: [id], onDelete: Cascade)

  @@map("rating_ranking")
}

model Collection {
  id          String          @id @default(uuid())
  userId      String

  name        String
  type        CollectionType
  description String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     CollectionEntry[]

  @@map("collections")
}

model CollectionEntry {
  id           String     @id @default(uuid())
  collectionId String
  levelId      String     // FK → levels.inGameId

  // Fractional index — lower = earlier in the collection (displayed asc).
  rankingIndex Decimal    @db.Decimal(20, 10)
  addedAt      DateTime   @default(now())

  // Relations
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  level        Level      @relation(fields: [levelId], references: [inGameId])

  @@unique([collectionId, levelId]) // A level can only appear once per collection
  @@map("collection_entries")
}

// ─────────────────────────────────────────────
// ACTIVITY LOG
// The parent row for every loggable event that is NOT already derivable from
// an existing timestamp.
//
// Deliberately NOT here: progress logs, completions and drops. Those are
// already events — ProgressUpdate.kind + loggedAt — and duplicating them into
// activity_log would create two records of one fact that can disagree. A
// timeline reads both and merges at query time (the "hybrid merge"); nothing
// in this schema needs to change for that to be built. Collection add/remove
// is not tracked at all. See docs/EVENT_LOG.md.
//
// Neither the timeline UI nor Discord notifications exist yet. The shape here
// is chosen so both can be added without a migration.
// ─────────────────────────────────────────────

model ActivityLog {
  id                String                  @id @default(uuid())
  userId            String

  eventType         ActivityEventType

  // The level the event is about. Null for RATING_CONFIG_CHANGE (user-scoped,
  // not level-scoped) and for the two list-wide ranking types,
  // DEMON_LIST_BULK_REPLACE and DEMON_LIST_REBALANCE, whose levels are their impact
  // rows. A single-level ranking event's mover level is BOTH here
  // and in its MOVER impact row: here so "this level's history" is one indexed
  // query, there so the mover carries the same index/position payload every
  // other touched level does.
  levelId           String?

  // Per-entry privacy, the same enum LevelProgress.visibility uses. Inert
  // until v4 public profiles ship — every route today is scoped to the
  // authenticated user's own data — but events are being written now and would
  // otherwise all be retroactively public the day a profile route lands.
  visibility        EntryVisibility         @default(PUBLIC)

  createdAt         DateTime                @default(now())
  // Total-order tiebreaker, and the field reconstruction should actually order
  // by. One request routinely writes two events — a placement that trips a
  // rebalance emits DEMON_LIST_REBALANCE then DEMON_LIST_PLACEMENT — and createdAt
  // cannot separate them reliably: Prisma stamps it per statement, so the two
  // are a millisecond apart at best and can land in the same one, and the
  // column DEFAULT is CURRENT_TIMESTAMP, which Postgres freezes at transaction
  // start for anything inserted by raw SQL. Ordering those two backwards makes
  // "the most recent logged listIndex as of T" read the stale coordinate
  // system. Order by (createdAt, sequence), or by sequence alone within a user.
  //
  // Int, not BigInt: 2^31 events is orders of magnitude beyond this app, and
  // Prisma maps BigInt to a JS BigInt that JSON.stringify throws on — a
  // landmine for the first read route that returns an event row.
  sequence          Int                     @default(autoincrement())

  // Relations
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: a level leaving the shared cache must not delete a
  // user's record of what they did. levelName on the impact rows is what keeps
  // such a row readable.
  level             Level?                  @relation(fields: [levelId], references: [inGameId], onDelete: SetNull)
  levelImpacts      ActivityLogLevelImpact[]
  fieldChanges      ActivityLogFieldChange[]

  // The timeline read: one user's events newest-first.
  @@index([userId, createdAt])
  // "This level's history" on a level page, and the purge that runs when a
  // user deletes their entry for a level.
  @@index([userId, levelId, createdAt])
  @@map("activity_log")
}

// One row per level actually touched by a demon list event: the mover, plus the
// levels immediately adjacent to it before or after the move. The two
// list-wide types (DEMON_LIST_BULK_REPLACE, DEMON_LIST_REBALANCE) instead carry one
// row per level in the list, since they rewrote every index. Children of the
// ranking event types only — no other event type has these.
model ActivityLogLevelImpact {
  id                String              @id @default(uuid())
  eventId           String

  // Nullable for the same reason ActivityLog.levelId is: history outlives the
  // level cache row.
  levelId           String?
  // DENORMALIZED, snapshotted at write time. This is what keeps the row
  // displayable after the referenced level's LevelProgress/ClassicDemonList is
  // deleted: deleting an entry deletes that level's OWN events, but every
  // other level's impact rows still name it, and there is no longer any
  // level_progress to join through for a name. Null only when the level cache
  // had no name at write time.
  levelName         String?

  role              ActivityImpactRole

  // The ACTUAL fractional index this level held after this event — never a
  // delta, never a boolean. Recording the real value on every write that
  // touches an ordering (bulk replaces and rebalances included) is what makes
  // snapshot-at-T reconstruction possible later without a snapshot table: a
  // level's index at time T is its most recent impact row at or before T.
  //
  // WHICH ordering it indexes is read off the event's type: DEMON_LIST_* events
  // carry classic_demon_list.listIndex, RATING_* events carry
  // rating_ranking.ratingIndex. One column rather than two nullable ones so the
  // NOT NULL keeps its teeth — an impact row always records a real index.
  orderIndex        Decimal             @db.Decimal(20, 10)

  // 1-based display positions (#1 = hardest), computed from the ordered
  // ranking before and after the event. positionBefore is null for an initial
  // placement; positionAfter is null for DEMON_LIST_REMOVED, and for a level a
  // DEMON_LIST_BULK_REPLACE dropped out of the demon list. Both are present and
  // equal on a DEMON_LIST_REBALANCE, which rewrites indices but no order.
  positionBefore    Int?
  positionAfter     Int?

  // The top-N threshold this level crossed on this event, or null for none.
  // DIRECTION is read off positionBefore/positionAfter — entering the top 10
  // and falling out of it are both `10`. An int rather than an enum because no
  // milestone-threshold model exists to point at; the thresholds live in
  // apps/api/src/services/activityLog/milestones.ts and can become per-user
  // config later without touching this column.
  milestoneCrossed  Int?

  // Relations
  event             ActivityLog         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  level             Level?              @relation(fields: [levelId], references: [inGameId], onDelete: SetNull)

  @@index([eventId])
  // The reconstruction read: one level's index history in event order.
  @@index([levelId])
  @@map("activity_log_level_impact")
}

// One row per field actually changed in a save. Children of LOG_EDIT (the
// user's edits to their own log entry) and of RATING_CONFIG_CHANGE (the
// weighted-rating config diff, category = RATING_CONFIG). One event per SAVE,
// not per field.
model ActivityLogFieldChange {
  id                String                @id @default(uuid())
  eventId           String

  // Raw field identifier, snake_case, matching the column it maps to:
  // `percentage`, `attempts`, `date`, `notes`, `simple_rating`,
  // `difficulty_opinion`. Per-category weighted scores are
  // `rating_score:<categoryId>`. Never filter on this — see `category`.
  fieldName         String
  category          ActivityFieldCategory

  // Serialized at the application layer; no typed column per field. Null means
  // the field had (or was given) no value, which is distinct from the string
  // "null" a caller would have to go out of its way to produce.
  oldValue          String?
  newValue          String?

  // Relations
  event             ActivityLog           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("activity_log_field_change")
}

// ─────────────────────────────────────────────
// API KEYS
// Third-party access tokens (e.g. Geode mod, community tools).
// Max 5 per user. Keys never stored in plaintext — only hash stored.
// ─────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(uuid())
  userId      String

  name        String    // e.g. "Geode Mod", "Community Dashboard"
  keyHash     String    @unique
  scopes      String[]  // e.g. ["completions:read", "completions:write"]

  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

// ─────────────────────────────────────────────
// MODERATION
// ─────────────────────────────────────────────

model Report {
  id                  String        @id @default(uuid())
  reporterId          String
  reportedUserId      String

  reason              String
  status              ReportStatus  @default(PENDING)
  // Never equals reportedUserId — enforced at application level.
  // Prevents reported moderator from seeing their own report.
  assignedModeratorId String?

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  reporter            User          @relation("ReporterRelation", fields: [reporterId], references: [id])
  reportedUser        User          @relation("ReportedUserRelation", fields: [reportedUserId], references: [id])
  assignedModerator   User?         @relation("AssignedModeratorRelation", fields: [assignedModeratorId], references: [id])

  @@map("reports")
}

model BanAppeal {
  id            String        @id @default(uuid())
  userId        String

  appealText    String
  status        AppealStatus  @default(PENDING)
  // One appeal per ban enforced at application level
  reviewedBy    String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user          User          @relation(fields: [userId], references: [id])
  reviewer      User?         @relation("ReviewedByRelation", fields: [reviewedBy], references: [id])

  @@map("ban_appeals")
}

// Permanent audit log of all moderation decisions.
// Never deleted — used for accountability and consistency review.
model ModerationAction {
  id              String                @id @default(uuid())
  moderatorId     String
  targetUserId    String

  action          ModerationActionType
  reason          String
  durationHours   Int?                  // Nullable — only for suspensions

  createdAt       DateTime              @default(now())

  // Relations
  moderator       User                  @relation("ModeratorRelation", fields: [moderatorId], references: [id])
  targetUser      User                  @relation("TargetUserRelation", fields: [targetUserId], references: [id])

  @@map("moderation_actions")
}

// Tracks an async GDDL submission-history import. The route Lambda upserts a
// pending row and returns the id immediately; the worker Lambda updates the
// row to completed/failed when the sync finishes. One row per user (userId
// is unique) — a new sync overwrites the previous job's fields via upsert
// rather than inserting a fresh row, so `id` is stable for a given user for
// the lifetime of their account (it does not change between sync runs).
// Because `id` doesn't vary per run, the client can't dedupe "have I shown
// this completion's toast" by id alone — `acknowledgedAt` is the per-run
// signal instead: POST /me/gddl-sync resets it (and `startedAt`) whenever a
// new sync starts, and POST /me/gddl-sync/ack sets it once the client has
// shown the result, scoped by both `id` and `startedAt` (not `id` alone) so
// a delayed ack from an old run can't land on a newer run that reused the
// same row. GET then stops returning an already-acknowledged completion,
// without any client-side storage.
model GddlSyncJob {
  id             String    @id @default(uuid())
  userId         String    @unique
  status         String    // "pending" | "completed" | "failed"
  result         Json?
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  acknowledgedAt DateTime?

  @@map("gddl_sync_jobs")
}

// ─────────────────────────────────────────────
// SPREADSHEET IMPORT
// One active import job per user (userId is unique — starting a new import
// deletes the previous job and all its rows, per product spec). The route
// Lambda persists the full row set up front (rows start "pending") and
// asynchronously invokes a worker Lambda with just the job id — the async
// Lambda invoke payload limit (256KB) is far too small for a full spreadsheet,
// so the dataset lives in Postgres, not in the invoke payload. The worker
// processes rows in batches, checkpointing processedRows/status after each
// batch so progress survives a closed tab, a reload, or the worker itself
// needing to self-reinvoke near the Lambda time limit.
// ─────────────────────────────────────────────

model ImportJob {
  id                 String         @id @default(uuid())
  userId             String         @unique
  status             String         @default("running") // "running" | "completed" | "failed"
  totalRows          Int            @default(0)
  processedRows      Int            @default(0)
  // Counts worker self-reinvocations near the Lambda time limit; hard-fails
  // the job past a cap so a permanently-broken row can't reinvoke forever.
  reinvokeCount       Int            @default(0)
  error              String?
  // One-shot payloads for the post-row-commit passes (each optional — only
  // present if that tab of the spreadsheet had rows), plus their results
  // once the worker runs them.
  rankingPayload     Json?
  collectionsPayload Json?
  ratingsPayload     Json?
  rankingResult      Json?
  collectionsResult  Json?
  ratingsResult      Json?
  createdAt          DateTime       @default(now())
  finishedAt         DateTime?

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows               ImportJobRow[]

  @@map("import_jobs")
}

model ImportJobRow {
  id           String    @id @default(uuid())
  jobId        String
  rowIndex     Int
  // Original parsed row payload (type/data/conflict resolution) — what the
  // worker needs to actually process this row.
  rawData      Json
  status       String    // "pending" | "committed" | "updated" | "skipped" | "failed"
  // Presence of issueMessage means this row is "flagged" for user review,
  // regardless of whether it still succeeded (dropped-value warning) or was
  // skipped/failed outright.
  issueMessage String?
  levelName    String?
  identifier   String?
  resolved     Boolean   @default(false)

  job          ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowIndex])
  @@map("import_job_rows")
}

// ─────────────────────────────────────────────
// LIST PRESETS
// Saved view configurations for the List page.
// Each preset stores column visibility, column order, sort specs,
// and filter state so the user can switch between named views.
// ─────────────────────────────────────────────

model LogPreset {
  id          String   @id @default(uuid())
  userId      String

  name        String
  description String?
  // One of 16 palette color IDs (e.g. "blue", "rose"). Stored as string
  // so the palette can be extended without a schema migration.
  color       String

  // Client-side view config stored as JSON blobs. The API treats these as
  // opaque — validation of the internal shape is left to the frontend.
  sorts       Json     // SortSpec[]
  filters     Json     // FilterState (excludes the text search field)
  columns     Json     // ColumnVisibility (Record<ColumnId, boolean>)
  columnOrder Json     // ColumnId[]
  // Display preference, not part of the JSON blobs above since it's a plain
  // boolean rather than an opaque client-owned shape. Hides the time-of-day
  // line under the date column across the whole list.
  hideTime    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("log_presets")
}
