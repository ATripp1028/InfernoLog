# Template for apps/web/.env.e2e — the local inputs to `pnpm test:e2e`.
# Copy to .env.e2e (gitignored; it holds a staging database credential) and
# fill it in. e2e/README.md has the rest of the setup.
#
# Loaded by e2e/run.ts through Node's `process.loadEnvFile`, which leaves
# already-set variables alone — so `E2E_STAGE=dev pnpm test:e2e` still wins for
# a single run. CI sets all of these from secrets and never has this file.
#
# Everything else the suite needs — API URL, user pool, E2E app client, Cognito
# domain — is resolved from /infernolog/<stage>/… in SSM at run time.

# The stage to run against. Required, no default, and never `production`:
# pointing the suite at a stage RESETS that stage's E2E user data.
E2E_STAGE=staging

# The dedicated E2E user, as provisioned by `pnpm --filter @infernolog/api
# e2e:provision`. The address must start with `e2e+` — the reset script
# refuses to touch anything else.
E2E_USER_EMAIL=e2e+staging@example.com
E2E_USER_PASSWORD=

# The database for E2E_STAGE. Passed explicitly to the reset script rather
# than inherited, so an unset value can never resolve to a local database.
# No shell parses this file, so the `&` in a Neon URL needs no quoting.
E2E_DATABASE_URL=

# AWS credentials come from the ambient environment (SSM reads and
# AdminInitiateAuth). A profile can live here instead if you use one.
# AWS_PROFILE=
