VITE_API_URL=http://localhost:3000
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Leave empty for local dev — an empty DSN disables the Sentry SDK entirely
# rather than initializing it disabled, so local runs stay quiet. Deployed
# stages get this baked in by apps/web/sst.config.ts.
VITE_SENTRY_DSN=
# Which Sentry environment deployed events are tagged with. Set from the SST
# stage at deploy time; irrelevant locally, where there is no DSN to send with.
VITE_SENTRY_ENVIRONMENT=