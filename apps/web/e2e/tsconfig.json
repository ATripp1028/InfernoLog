{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@infernolog/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // The specs run in Node and drive a browser through Playwright's API —
    // they never touch a DOM directly, so DOM lib types are deliberately
    // absent. A spec reaching for `document` is a mistake this catches.
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts"]
}
