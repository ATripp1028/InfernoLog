{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],// Core is not built, but we have this here in case we ever add a build step to core. This will ensure that all packages that depend on core will be rebuilt if core is rebuilt.
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "typecheck:infra": {
      "cache": false
    },
    "test": {
      "cache": false
    }
  }
}